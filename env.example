# Copy this file to .env and fill in real values before deploying.
# Never commit a real .env file.

ICS_ENV=production
ICS_DEBUG=false

# For SQLite (default, fine for small deployments / demos):
ICS_DATABASE_URL=sqlite:///./ics_platform.db

# For PostgreSQL (recommended for production):
# ICS_DATABASE_URL=postgresql+psycopg2://ics_user:password@localhost:5432/ics_platform

# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
ICS_SECRET_KEY=change-me-to-a-long-random-value

ICS_SESSION_TIMEOUT_MIN=60
ICS_LOG_DIR=logs
ICS_LOG_LEVEL=INFO
